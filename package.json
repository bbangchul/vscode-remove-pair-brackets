{
  "name": "remove-pair-brackets",
  "displayName": "Remove Pair Brackets",
  "description": "Remove the nearest enclosing (), [] or {} while keeping its contents.",
  "version": "0.1.3",
  "publisher": "SeongCheolBang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:removePairBrackets.removeNearest"
  ],
  "contributes": {
    "commands": [
      {
        "command": "removePairBrackets.removeNearest",
        "title": "Remove Pair Brackets: Remove Nearest Enclosing Pair"
      }
    ],
    "keybindings": [
      {
        "command": "removePairBrackets.removeNearest",
        "key": "cmd+backspace",
        "mac": "cmd+backspace",
        "when": "editorTextFocus && !editorReadonly && isMac"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "python3 scripts/package.py",
    "package:vsce": "npx @vscode/vsce package --allow-missing-repository"
  },
  "keywords": [
    "brackets",
    "unwrap",
    "parentheses",
    "mac"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbangchul/vscode-remove-pair-brackets.git"
  },
  "bugs": {
    "url": "https://github.com/bbangchul/vscode-remove-pair-brackets/issues"
  },
  "homepage": "https://github.com/bbangchul/vscode-remove-pair-brackets#readme"
}
